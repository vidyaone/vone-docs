{
  "info": {
    "name": "vWebsite-AdminAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-vweb.vidyaone.com/test/admin/",
      "description": "Testing environment (appsettings.Testing.json → App:BaseUrl). This collection targets Testing only."
    },
    {
      "key": "product",
      "value": "vweb",
      "description": "Calling product identifier — the identifier of whichever client app is calling this API (e.g. vweb). Not stored in this project's own config; supplied by each calling client app. Prefix with test- to run in test mode (e.g. test-vweb)."
    }
  ],
  "item": [
    {
      "name": "DataJson",
      "item": [
        {
          "name": "Get data file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}data?product={{product}}&file=data_home.json",
              "host": ["{{baseUrl}}data"],
              "query": [
                { "key": "product", "value": "{{product}}" },
                { "key": "file", "value": "data_home.json" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Save data file",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}data?product={{product}}",
              "host": ["{{baseUrl}}data"],
              "query": [
                { "key": "product", "value": "{{product}}" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file\": \"data_home.json\",\n  \"data\": {\n    \"hero\": { \"title\": \"Welcome\", \"image\": \"hero.png\" },\n    \"sections\": [ { \"type\": \"text\", \"body\": \"About us\" } ]\n  },\n  \"upload_files\": [\n    { \"file_name\": \"hero.png\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    },
