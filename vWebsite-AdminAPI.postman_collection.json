{
  "info": {
    "name": "vWebsite-AdminAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-vweb.vidyaone.com/test/admin/",
      "description": "Testing environment (appsettings.Testing.json → App:BaseUrl). This collection targets Testing only."
    },
    {
      "key": "product",
      "value": "vweb",
      "description": "Calling product identifier — the identifier of whichever client app is calling this API (e.g. vweb). Not stored in this project's own config; supplied by each calling client app. Prefix with test- to run in test mode (e.g. test-vweb)."
    }
  ],
  "item": [
    {
      "name": "DataJson",
      "item": [
        {
          "name": "Get data file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}data?product={{product}}&file=data_home.json",
              "host": ["{{baseUrl}}data"],
              "query": [
                { "key": "product", "value": "{{product}}" },
                { "key": "file", "value": "data_home.json" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Save data file",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}data?product={{product}}",
              "host": ["{{baseUrl}}data"],
              "query": [
                { "key": "product", "value": "{{product}}" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file\": \"data_home.json\",\n  \"data\": {\n    \"hero\": { \"title\": \"Welcome\", \"image\": \"hero.png\" },\n    \"sections\": [ { \"type\": \"text\", \"body\": \"About us\" } ]\n  },\n  \"upload_files\": [\n    { \"file_name\": \"hero.png\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Module",
      "item": [
        {
          "name": "List modules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}module?product={{product}}",
              "host": ["{{baseUrl}}module"],
              "query": [
                { "key": "product", "value": "{{product}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get module status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}module/status?product={{product}}&moduleName=data_home",
              "host": ["{{baseUrl}}module/status"],
              "query": [
                { "key": "product", "value": "{{product}}" },
                { "key": "moduleName", "value": "data_home" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get module limit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}module/limit?product={{product}}",
              "host": ["{{baseUrl}}module/limit"],
              "query": [
                { "key": "product", "value": "{{product}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Save module statuses",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}module?product={{product}}",
              "host": ["{{baseUrl}}module"],
              "query": [
                { "key": "product", "value": "{{product}}" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"moduleName\": \"data_home\",  \"status\": true  },\n  { \"moduleName\": \"data_about\", \"status\": false },\n  { \"moduleName\": \"data_blog\" }\n]",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Page",
      "item": [
        {
          "name": "List pages",
          "request": {
            "method": "GET",
            "header": [],
