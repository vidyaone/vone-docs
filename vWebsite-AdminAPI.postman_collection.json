      "item": [
        {
          "name": "List plugins",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}plugin?product={{product}}&planStatus=Active&planType=Free&pluginName=Notice&pageNumber=1&pageSize=50",
              "host": [
                "{{baseUrl}}plugin"
              ],
              "query": [
                {
                  "key": "product",
                  "value": "{{product}}"
                },
                {
                  "key": "planStatus",
