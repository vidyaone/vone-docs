            "url": {
              "raw": "{{baseUrl}}page?product={{product}}",
              "host": ["{{baseUrl}}page"],
              "query": [
                { "key": "product", "value": "{{product}}" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  { \"pageName\": \"about\",   \"moduleName\": \"data_about\", \"status\": true  },\n  { \"pageName\": \"contact\", \"moduleName\": \"data_about\", \"status\": false },\n  { \"pageName\": \"blog\" }\n]",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        }
      ]
    },
