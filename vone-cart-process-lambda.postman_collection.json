{
  "info": {
    "name": "vone-cart-process-lambda",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.vidyaone.com",
      "description": "Testing environment host — shared by both config.py constants: API_BASE_URL (/website/cart) and PAY_AS_GUEST_BASE_URL (/payment/payasguest)."
    }
  ],
  "item": [
    {
      "name": "Cart",
      "item": [
        {
          "name": "GET /website/cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/website/cart?guest_id=guest_a1b2c3d4&user_id=10234",
              "host": ["{{baseUrl}}"],
              "path": ["website", "cart"],
              "query": [
                { "key": "guest_id", "value": "guest_a1b2c3d4" },
                { "key": "user_id", "value": "10234" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /payment/payasguest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payment/payasguest?guest_id=guest_a1b2c3d4&user_id=10234",
              "host": ["{{baseUrl}}"],
              "path": ["payment", "payasguest"],
              "query": [
                { "key": "guest_id", "value": "guest_a1b2c3d4" },
                { "key": "user_id", "value": "10234" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /website/cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/website/cart?guest_id=guest_a1b2c3d4&user_id=10234&item_id=c4d1e2f3-9a8b-4c5d-8e7f-1a2b3c4d5e6f",
              "host": ["{{baseUrl}}"],
              "path": ["website", "cart"],
              "query": [
                { "key": "guest_id", "value": "guest_a1b2c3d4" },
                { "key": "user_id", "value": "10234" },
                { "key": "item_id", "value": "c4d1e2f3-9a8b-4c5d-8e7f-1a2b3c4d5e6f" }
              ]
            }
          },
          "response": []
